# Normalise line endings so the same file does not show up as modified just
# because one machine uses CRLF and another uses LF. Without this, working on
# Windows and building on Linux (Vercel) produces constant phantom diffs.

* text=auto

# Generated by Next.js on every install/build — never a meaningful diff.
next-env.d.ts text eol=lf
tsconfig.json text eol=lf

# Shell scripts must stay LF or they break on Linux.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-only tooling.
*.ps1 text eol=crlf

# Binary assets must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
