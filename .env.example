# ---------------------------------------------------------------------------
# Supabase — required for the public site and the CMS to work.
# Find these under Project Settings > API in the Supabase dashboard.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Public site origin — used for canonical URLs, Open Graph and sitemap.xml.
# Defaults to https://kevnportfolio.dev when unset.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Contact address shown in the hero, footer and contact page.
# Placeholder: hello@example.com
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Resume PDF.
#
# `npm run resume:pdf` renders /resume in a real browser and writes the result to
# public/resume.pdf. Point this at that file and the page grows a one-click
# download button beside the print action:
#
#   NEXT_PUBLIC_RESUME_URL=/resume.pdf
#
# Leave it empty and no download button renders; "Print or save as PDF" still
# works either way. Do not point it at a file that does not exist — the button is
# a plain link, so it would 404 at exactly the moment someone is handing you the
# CV. Recruiters open these offline, which is why it is a file in public/ and not
# a redirect.
#
# public/resume.pdf is a build artifact. Re-run `npm run resume:pdf` after
# changing any experience, project or certificate, or the download quietly
# serves the previous version. tests/resume-pdf.spec.ts fails when that happens.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_RESUME_URL=/resume.pdf

# ---------------------------------------------------------------------------
# Contact form delivery (optional).
#
# The contact form works without this, but it will report that no delivery
# channel is configured and ask the visitor to email directly instead of
# pretending the message was sent. Point it at a serverless function, Zapier
# hook or Discord webhook to enable real delivery.
#
# This is read on the server only and is never exposed to the browser.
# ---------------------------------------------------------------------------
CONTACT_WEBHOOK_URL=
